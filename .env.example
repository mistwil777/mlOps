# MLOps Project — Environment Variables Template
# Copy to .env and fill in values. Never commit .env to Git.

# Anthropic (platform advisor — Claude Sonnet)
ANTHROPIC_API_KEY=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=mlops-default

# LanceDB
LANCEDB_PATH=/Users/wlerouli/Documents/GitHub/mlOps/lancedb

# Ollama (local embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# MLX serving
MLX_MODEL_PATH=/Users/wlerouli/Documents/GitHub/mlOps/models
SERVING_PORT=8080

# Logging
LOG_LEVEL=INFO

# AWS Bedrock (baseline measurements only — never in production inference)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_MODEL_GENERATION=us.amazon.nova-pro-v1:0
AWS_BEDROCK_MODEL_ANALYSIS=us.amazon.nova-lite-v1:0

# Migrator source repo (read-only)
MIGRATOR_REPO_PATH=/Users/wlerouli/migrator

# SQLite metadata DB
SQLITE_DB_PATH=/Users/wlerouli/Documents/GitHub/mlOps/experiments/mlops.db

# SearXNG (local meta-search — primary engine for AWA source discovery)
# Start with: docker compose up searxng -d
# Aggregates Google, Bing, DuckDuckGo, GitHub — no API key required
SEARXNG_URL=http://localhost:8889

# Brave Search API (optional — fallback when SearXNG + DuckDuckGo both fail)
# Free tier: 2000 requests/month — https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
